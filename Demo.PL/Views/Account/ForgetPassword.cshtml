@model ForgetPasswordViewModel
@{
    ViewData["Title"] = "ForgetPassword";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
<div class="main-agileinfo">
	<div class="agileits-top">
		<div asp-validation-summary="All"></div>
		<form asp-action="SentEmail" method="post">
			<input class="text email" asp-for="@Model.Email" placeholder="Email" required="">
			<span asp-validation-for="@Model.Email" class="text-danger"></span>
			<input type="submit" value="Forget Password">
			<input asp-action="SentSms" type="submit" value="Sms By Phone" />
		</form>
	</div>
</div>
@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}

