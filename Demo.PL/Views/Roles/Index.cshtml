@model IEnumerable<RolesViewModel>
@{
    ViewData["Title"] = "Index";
}

<h1>All Roles</h1>
<br />
<br />
<a asp-action="Create" class="btn btn-primary">Create New Roles</a>
<br />
<br />
<form class="my-3" asp-action="Index" asp-controller="Roles">
    <div class="row">
        <div class="col-sm-8">
            <input placeholder="Search..." name="searchValue" class="form-control" />
        </div>
        <div class="col-sm-4">
            <input type="submit" value="Search" class="btn btn-success btn-block" />
        </div>
    </div>
</form>
@if (Model?.Count() > 0)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">@Html.DisplayNameFor(x => x.Id)</th>
                <th scope="col">@Html.DisplayNameFor(x => x.Name)</th>
                <th scope="col">Details</th>
                <th scope="col">Update</th>
                <th scope="col">Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(x => item.Id)</td>
                    <td>@Html.DisplayFor(x => item.Name)</td>
                    <partial name="ButtonPartialView" model="item.Id" />
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">
        Not Found Roles
    </div>
}

