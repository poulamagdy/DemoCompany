@model RolesViewModel
@{
    ViewData["Title"] = "Update";
}

<h1>Update</h1>

<div class="row">
    <div class="col-md-12">
        <div asp-validation-summary="All"></div>
        <form asp-action="Update">
            <div class="form-group my-2">
                <label asp-for="@Model.Id" class="col-from-label"></label>
                <input asp-for="@Model.Id" class="form-control" readonly/>
            </div>
            <div class="form-group my-2">
                <label asp-for="@Model.Name" class="col-from-label"></label>
                <input asp-for="@Model.Name" class="form-control" />
                <span asp-validation-for="@Model.Name" class="text-danger"></span>
            </div>
            <br />
            <div class="my-3">
                <a class="btn btn-info" asp-action="AddOrRemoveUsers" asp-controller="Roles" asp-route-roleId="@Model.Id">Add Or Remove Users</a>
            </div>
            <input type="submit" value="Update" class="btn btn-primary" />
            <a class="btn btn-secondary" asp-action="Index">Back</a>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}