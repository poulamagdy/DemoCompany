@model RolesViewModel
@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div class="row">
    <div class="col-md-12">
        <form>
            <div class="form-group">
                <label asp-for="@Model.Id" class="col-from-label"></label>
                <input asp-for="@Model.Id" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="@Model.Name" class="col-from-label"></label>
                <input asp-for="@Model.Name" class="form-control" readonly />
            </div>
            <br />
            <a class="btn btn-primary" asp-action="Update" asp-route-id="@Model.Id">Update</a>
            <a class="btn btn-secondary" asp-action="Index">Back</a>
        </form>
    </div>
</div>
