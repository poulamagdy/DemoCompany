@model IEnumerable<EmployeeViewModel>
@{
    ViewData["Title"] = "Index";
}

<h1>All Employee</h1>
<br />
<a asp-action="Create" class="btn btn-primary">Create New Employee</a>
<br />
<br />
<form class="my-3" asp-action="Index" asp-controller="Employee">
    <div class="row">
        <div class="col-sm-8">
            <input placeholder="Search By Email" name="searchValue" class="form-control"/>
        </div>
        <div class="col-sm-4">
            <input type="submit" value="Search" class="btn btn-success btn-block"/>
        </div>
    </div>
</form>

@if(Model.Count() > 0)
{
    <table class="table table-striped">
        <tr>
            <th scope="col">@Html.DisplayNameFor(e => e.Name)</th>
            <th scope="col">@Html.DisplayNameFor(e => e.Image)</th>
            <th scope="col">@Html.DisplayNameFor(e => e.Department)</th>
            <th scope="col">@Html.DisplayNameFor(e => e.Address)</th>
            <th scope="col">@Html.DisplayNameFor(e => e.Salary)</th>
            <th scope="col">@Html.DisplayNameFor(e => e.Email)</th>
            <th scope="col">@Html.DisplayNameFor(e => e.HireDate)</th>
            <th scope="col">@Html.DisplayNameFor(e => e.IsActive)</th>
            <th scope="col">Details</th>
            <th scope="col">Update</th>
            <th scope="col">Delete</th>
        </tr>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>
                        <img src="~/Files/Images/@item.ImageName" class="rounded" alt="img employee" height="50" width="50" />
                    </td>
                    <td>@item.Department.Name</td>
                    <td>@item.Address</td>
                    <td>@item.Salary</td>
                    <td>@item.Email</td>
                    <td>@item.HireDate</td>
                    <td>@item.IsActive</td>
                    <partial name="ButtonPartialView" model="@item.Id.ToString()"/>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div>
        <div class="alert alert-warning">
            Not Found Any Employees
        </div>
    </div>
}

