@model EmployeeViewModel
@{
    ViewData["Title"] = "Create";
    var department = new SelectList(ViewBag.department, "Id", "Name");
}

<h1>Create New Employee</h1>

<div class="row">
    <div class="col-md-12">
        <div asp-validation-summary="All"></div>
        <form asp-action="Create" enctype="multipart/form-data">
            <div class="form-group">
                <label asp-for="@Model.Name" class="col-from-label"></label>
                <input asp-for="@Model.Name" class="form-control" />
                <span asp-validation-for="@Model.Name" class="text-danger"></span>
            </div>
            <div class="form-group my-2">
                <label asp-for="@Model.Address" class="col-from-label"></label>
                <input asp-for="@Model.Address" class="form-control" />
                <span asp-validation-for="@Model.Address" class="text-danger"></span>
            </div>
            <div class="form-group my-2">
                <label asp-for="@Model.Salary" class="col-from-label"></label>
                <input asp-for="@Model.Salary" class="form-control" />
                <span asp-validation-for="@Model.Salary" class="text-danger"></span>
            </div>
            <div class="form-group my-2">
                <label asp-for="@Model.Email" class="col-from-label"></label>
                <input asp-for="@Model.Email" class="form-control" />
                <span asp-validation-for="@Model.Email" class="text-danger"></span>
            </div>
            <div class="form-group my-2">
                <label asp-for="@Model.HireDate" class="col-from-label"></label>
                <input asp-for="@Model.HireDate" class="form-control" />
                <span asp-validation-for="@Model.HireDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="@Model.DepartmentId" class="col-from-label"></label>
                <select asp-for="@Model.DepartmentId" asp-items="department" class="form-control">
                    <option>------select department------</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="@Model.Image" class="col-from-label"></label>
                <input asp-for="@Model.Image" class="form-control" />
            </div>
            <div class="form-group form-check my-1">
                <input class="form-check-input" type="checkbox" asp-for="@Model.IsActive">
                <label asp-for="@Model.IsActive" class="form-check-label"></label>
            </div>
            <br />
            <input type="submit" value="Add" class="btn btn-primary" />
            <a class="btn btn-secondary" asp-action="Index">Back</a>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

