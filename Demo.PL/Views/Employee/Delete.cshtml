@model EmployeeViewModel
@{
    ViewData["Title"] = "Details";
    var department = ViewBag.departmentName;
}

<h1>@Model.Name Employee</h1>

<div class="row">
    <div class="col-md-12">
        <form asp-action="Delete">
            <div class="form-group">
                <img src="~/Files/Images/@Model.ImageName" class="rounded" height="100" width="100" alt="emp-img" />
                <input asp-for="@Model.ImageName" hidden/>
            </div>
            <div class="form-group">
                <label asp-for="@Model.Name" class="col-from-label"></label>
                <input asp-for="@Model.Name" class="form-control" readonly />
            </div>
            <div class="form-group my-2">
                <label asp-for="@Model.Address" class="col-from-label"></label>
                <input asp-for="@Model.Address" class="form-control" readonly />
            </div>
            <div class="form-group my-2">
                <label asp-for="@Model.Salary" class="col-from-label"></label>
                <input asp-for="@Model.Salary" class="form-control" readonly />
            </div>
            <div class="form-group my-2">
                <label asp-for="@Model.Email" class="col-from-label"></label>
                <input asp-for="@Model.Email" class="form-control" readonly />
            </div>
            <div class="form-group my-2">
                <label asp-for="@Model.HireDate" class="col-from-label"></label>
                <input asp-for="@Model.HireDate" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label class="col-from-label">Department Name</label>
                <input value="@department" class="form-control" readonly />
            </div>
            <div class="form-group my-1">
                <label asp-for="@Model.IsActive" class="form-check-label"></label>
                <input class="form-control" value=@(Model.IsActive ? "True" : "False") readonly />
                <br />
            </div>
            <input type="submit" value="Delete" class="btn btn-primary"/>
            <a class="btn btn-secondary" asp-action="Index">Back</a>
        </form>
    </div>
</div>
