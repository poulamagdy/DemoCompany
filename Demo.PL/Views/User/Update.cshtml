@model UserViewModel
@{
    ViewData["Title"] = "Update";
}

<h1>Update For User Name : @Model.UserName</h1>

<div class="row">
    <div class="col-md-12">
        <div asp-validation-summary="All"></div>
        <form asp-action="Update">
            <input type="hidden" asp-for="@Model.Email" />
            <input type="hidden" asp-for="@Model.Roles" />
            <div class="form-group">
                <label asp-for="@Model.Id" class="col-from-label"></label>
                <input asp-for="@Model.Id" class="form-control" readonly/>
            </div>
            <div class="form-group my-2">
                <label asp-for="@Model.UserName" class="col-from-label"></label>
                <input asp-for="@Model.UserName" class="form-control" />
                <span asp-validation-for="@Model.UserName" class="text-danger"></span>
            </div>
            <br />
            <input type="submit" value="Add" class="btn btn-primary" />
            <a class="btn btn-secondary" asp-action="Index">Back</a>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
