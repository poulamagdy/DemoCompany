@model UserViewModel
@{
    ViewData["Title"] = "Delete";
}
<div class="row">
    <div class="col-md-12">
        <form asp-action="Delete">
            <div class="form-group">
                <label asp-for="@Model.Id" class="col-from-label"></label>
                <input asp-for="@Model.Id" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="@Model.UserName" class="col-from-label"></label>
                <input asp-for="@Model.UserName" class="form-control" readonly />
            </div>
            <div class="form-group my-2">
                <label asp-for="@Model.Email" class="col-from-label"></label>
                <input asp-for="@Model.Email" class="form-control" readonly />
            </div>
            <div class="form-group my-2">
                <label asp-for="@Model.Roles" class="col-from-label"></label>
                <input value="@((Model.Roles is null) ? string.Empty : string.Join(",",Model.Roles))" class="form-control" readonly />
            </div>
            <br />
            <input type="submit" class="btn btn-primary" value="Delete" />
            <a class="btn btn-secondary" asp-action="Index">Back</a>
        </form>
    </div>
</div>

